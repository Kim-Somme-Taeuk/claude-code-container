#!/bin/sh
# xsel shim - proxies clipboard requests to CCC host clipboard server
# Supports: xsel --clipboard --output

if [ -z "$CCC_CLIPBOARD_URL" ]; then
    echo "xsel: clipboard not available (not running in CCC session)" >&2
    exit 1
fi

# Prefer a readable mounted token; otherwise keep the per-session token.
if [ -f /run/ccc/clipboard.port ] && [ -r /run/ccc/clipboard.port ]; then
    CCC_CLIPBOARD_TOKEN=$(cut -d: -f2- /run/ccc/clipboard.port)
fi

OUTPUT=0
INPUT=0
CLIPBOARD=0

while [ $# -gt 0 ]; do
    case "$1" in
        --clipboard|-b)
            CLIPBOARD=1
            shift
            ;;
        --output|-o)
            OUTPUT=1
            shift
            ;;
        --input|-i)
            INPUT=1
            shift
            ;;
        *)
            echo "xsel: unsupported clipboard option" >&2
            exit 1
            ;;
    esac
done

[ "$CLIPBOARD" = 1 ] || { echo "xsel: only clipboard selection is supported" >&2; exit 1; }
[ "$INPUT" = 0 ] || [ "$OUTPUT" = 0 ] || {
    echo "xsel: conflicting input/output options" >&2
    exit 1
}

if [ "$OUTPUT" = "1" ]; then
    _data=$(curl -sf --connect-timeout 3 --max-time 10 -H "Authorization: Bearer $CCC_CLIPBOARD_TOKEN" "$CCC_CLIPBOARD_URL/clipboard/text" 2>/dev/null) || { echo "xsel: clipboard server error" >&2; exit 1; }
    [ -n "$_data" ] || { echo "xsel: clipboard is empty" >&2; exit 1; }
    printf '%s' "$_data"
    exit 0
fi

_status=$(curl -fs --connect-timeout 3 --max-time 10 \
    -H "Authorization: Bearer $CCC_CLIPBOARD_TOKEN" \
    -H "Content-Type: text/plain;charset=utf-8" \
    --data-binary @- -o /dev/null -w '%{http_code}' \
    "$CCC_CLIPBOARD_URL/clipboard/text") || {
    echo "xsel: clipboard server error" >&2
    exit 1
}
case "$_status" in
    2??) exit 0 ;;
    *) echo "xsel: clipboard server error" >&2; exit 1 ;;
esac
