{
  "name": "@ccc/device-lab-mcp",
  "version": "1.1.90",
  "type": "module",
  "description": "MCP adapter for Device Lab",
  "bin": {
    "device-lab-mcp": "server.mjs"
  },
  "exports": {
    ".": "./server.mjs",
    "./src/*": "./src/*"
  },
  "files": [
    "server.mjs",
    "src/",
    "dist/",
    "scripts/build.mjs"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@ccc/device-lab": "1.1.90",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "pngjs": "^7.0.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "esbuild-wasm": "^0.28.0"
  }
}
